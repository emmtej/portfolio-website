---
import { cn } from "../../utils/cn";
import Text from "./Text.astro";
import { sectionWidths, type SectionWidth } from "./primitives.tokens";

interface Props {
  title?: string;
  className?: string;
  width?: SectionWidth;
}

const { 
  title, 
  className, 
  width = "default",
} = Astro.props;
---

<section class={cn("space-y-6 md:space-y-8", sectionWidths[width], className)}>
  {title ? <Text variant="h2">{title}</Text> : null}
  <slot />
</section>
