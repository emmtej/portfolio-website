---
import { getServerT, resolveLocale } from "../utils/server-t";
import { cn } from "../utils/cn";
import HeaderLink from "./ui/HeaderLink.astro";
import HeaderSeparator from "./ui/HeaderSeparator.astro";
import Text from "./ui/Text.astro";

const locale = resolveLocale(Astro.currentLocale, Astro.url.pathname);
const t = getServerT(locale);
const isIt = locale === "it";
---

<header class="flex flex-col gap-12 pt-2 md:gap-14 md:pt-4">
  <div class="flex min-w-0 items-center">
    <Text
      variant="meta"
      size="tiny"
      className="flex min-w-0 max-w-full flex-wrap items-center gap-x-4 gap-y-2"
    >
      <HeaderLink
        href="https://github.com/emmtej"
        target="_blank"
        rel="noopener noreferrer"
      >
        [GH].EMMTEJ
      </HeaderLink>
      <HeaderSeparator className="hidden sm:inline" />
      <HeaderLink href="mailto:contact@emmanueltejeda.com">
        [EMAIL].CONTACT
      </HeaderLink>
    </Text>
  </div>
  <h1 class="text-[clamp(2.5rem,10vw,6rem)] font-bold tracking-tight text-text-main leading-[0.85]">
    {(t("app.title.greeting") as string)
      .split(" ")
      .map((word: string, i: number) => (
        <span
          class={cn(
            "mr-3 transition-colors duration-slow",
            isIt && i === 0 && "text-it-green",
            isIt && i === 1 && "text-it-red",
          )}
        >
          {word}{" "}
        </span>
      ))}
    <br />
    <span class="text-text-main">Emmanuel</span>
  </h1>
</header>
