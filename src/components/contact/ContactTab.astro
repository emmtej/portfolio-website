---
import { getServerT, resolveLocale } from "../../utils/server-t";
import { ContactForm } from "./ContactForm";
import Text from "../ui/Text.astro";
import SocialLink from "./SocialLink.astro";
import { SOCIALS } from "./constants";
import Section from "../ui/Section.astro";

const locale = resolveLocale(Astro.currentLocale, Astro.url.pathname);
const t = getServerT(locale);
---

<div class="space-y-10 md:space-y-12">
  <Section title={t("contact.title") as string} width="narrow">
    <Text className="text-sm md:text-base leading-relaxed">
      {t("contact.intro")}
    </Text>
  </Section>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
    <div class="lg:col-span-7 order-2 lg:order-1">
      <ContactForm client:visible locale={locale} />
    </div>

    <div class="lg:col-span-5 space-y-6 order-1 lg:order-2">
      <Section title={t("contact.find_me_title") as string} width="full" className="space-y-4 md:space-y-5">
        <div class="flex flex-col border-t border-border-subtle">
          {SOCIALS.map((social) => (
            <SocialLink
              label={social.label}
              href={social.href}
              value={social.value}
              icon={social.icon}
              copiedLabel={t("contact.copied") as string}
            />
          ))}
        </div>
      </Section>
    </div>
  </div>
</div>
