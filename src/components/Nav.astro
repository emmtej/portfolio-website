---
import { getServerT, resolveLocale } from "../utils/server-t";
import { cn } from "../utils/cn";
import { RomeAvailabilityDot } from "./ui/RomeAvailabilityDot";

const locale = resolveLocale(Astro.currentLocale, Astro.url.pathname);
const t = getServerT(locale);
const { pathname } = Astro.url;
const segments = pathname.split("/").filter(Boolean);
const activeTabId = (locale === "it" ? segments[1] : segments[0]) || "about";

const TABS = [
  { id: "about", label: t("nav.about"), shortLabel: t("nav.about") },
  { id: "development", label: t("nav.development"), shortLabel: "Dev" },
  { id: "audio", label: t("nav.audio"), shortLabel: "Audio" },
  { id: "contact", label: t("nav.contact"), shortLabel: t("nav.contact") },
];

function getLocalizedUrl(id: string) {
  const prefix = locale === "it" ? "/it" : "";
  if (id === "about") return prefix || "/";
  return `${prefix}/${id}`;
}

const tabLinkClass =
  "relative inline-flex h-chrome-control items-center gap-2 whitespace-nowrap shrink-0 snap-center -mb-px border-b-2 border-transparent text-xs font-bold uppercase tracking-wider md:tracking-widest text-inactive transition-colors hover:text-text-main";
---

<nav
  aria-label="Primary"
  class="flex h-chrome-control items-center gap-4 md:gap-6 overflow-x-auto scrollbar-hide snap-x snap-mandatory"
>
  {TABS.map((tab) => {
    const isActive = activeTabId === tab.id;
    return (
      <a
        href={getLocalizedUrl(tab.id)}
        class={cn(tabLinkClass, isActive && "border-text-main text-text-main")}
        aria-current={isActive ? "page" : undefined}
        aria-label={tab.label as string}
      >
        <span class="md:hidden">{tab.shortLabel}</span>
        <span class="hidden md:inline">{tab.label}</span>
        {tab.id === "contact" && <RomeAvailabilityDot client:idle />}
      </a>
    );
  })}
</nav>
