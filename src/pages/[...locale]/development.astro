---
import MainLayout from '../../layouts/MainLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import DevelopmentTab from '../../components/development/DevelopmentTab.astro';

export function getStaticPaths() {
  return [
    { params: { locale: undefined } },
    { params: { locale: 'it' } },
  ];
}
---

<MainLayout 
	title="Emmanuel T. || Development" 
	description="Frontend projects and technical skills. Specializing in React, TypeScript, and high-performance web applications."
>
	<SiteHeader />
	<div id="main-content" class="mt-6 md:mt-8">
		<DevelopmentTab />
	</div>
</MainLayout>
