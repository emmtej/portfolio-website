---
import MainLayout from '../../layouts/MainLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import ContactTab from '../../components/contact/ContactTab.astro';

export function getStaticPaths() {
  return [
    { params: { locale: undefined } },
    { params: { locale: 'it' } },
  ];
}
---

<MainLayout 
	title="Emmanuel T. || Contact" 
	description="Get in touch for freelance work, project inquiries, or just to say hello. Available for remote opportunities."
>
	<SiteHeader />
	<div id="main-content" class="mt-6 md:mt-8">
		<ContactTab />
	</div>
</MainLayout>
