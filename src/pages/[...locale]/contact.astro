---
import MainLayout from '../../layouts/MainLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import ContactTab from '../../components/contact/ContactTab.astro';
import { getServerT, resolveLocale } from '../../utils/server-t';

export function getStaticPaths() {
  return [
    { params: { locale: undefined } },
    { params: { locale: 'it' } },
  ];
}

const locale = resolveLocale(Astro.currentLocale, Astro.url.pathname);
const t = getServerT(locale);
---

<MainLayout 
	title={t("meta.contact.title") as string} 
	description={t("meta.contact.description") as string}
>
	<SiteHeader />
	<div id="main-content" class="mt-6 md:mt-8">
		<ContactTab />
	</div>
</MainLayout>
