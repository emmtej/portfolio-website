---
import MainLayout from '../../layouts/MainLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import TabPanels from '../../components/TabPanels.astro';
import { getServerT, resolveLocale } from '../../utils/server-t';

export function getStaticPaths() {
  return [
    { params: { locale: undefined } },
    { params: { locale: 'it' } },
  ];
}

const locale = resolveLocale(Astro.currentLocale, Astro.url.pathname);
const t = getServerT(locale);
---

<MainLayout
	intro
	title={t("meta.home.title") as string} 
	description={t("meta.home.description") as string}
>
	<SiteHeader />
	<TabPanels activeTab="about" />
</MainLayout>
