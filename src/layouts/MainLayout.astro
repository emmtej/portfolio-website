---
import "@fontsource-variable/inter";
import '../index.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { RomeAvailability } from '../components/ui/RomeAvailability';
import NetlifyFormStub from '../components/contact/NetlifyFormStub.astro';

interface Props {
	title?: string;
	description?: string;
}

const { 
	title = "Emmanuel T. | Software Developer",
	description = "Full-stack web developer specializing in building modern, responsive websites using the React ecosystem, TypeScript, and Tailwind CSS."
} = Astro.props;

const locale = Astro.currentLocale || "en";
const canonical = new URL(Astro.url.pathname, "https://emmanueltejeda.com").href;
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="UTF-8" />
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="ET|DEV" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />

		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta name="author" content="Emmanuel T." />
		<link rel="canonical" href={canonical} />

		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content="https://emmanueltejeda.com/og-image.png" />

		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonical} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content="https://emmanueltejeda.com/og-image.png" />

		<link rel="alternate" hreflang="en" href={new URL(Astro.url.pathname.replace(/^\/it/, ""), "https://emmanueltejeda.com").href} />
		<link rel="alternate" hreflang="it" href={new URL("/it" + Astro.url.pathname.replace(/^\/it/, ""), "https://emmanueltejeda.com").href} />
		<link rel="alternate" hreflang="x-default" href={new URL(Astro.url.pathname.replace(/^\/it/, ""), "https://emmanueltejeda.com").href} />

		<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />

		<script is:inline>
			(function () {
				const saved = localStorage.getItem("theme");
				if (
					saved === "dark" ||
					(!saved && window.matchMedia("(prefers-color-scheme: dark)").matches)
				) {
					document.documentElement.classList.add("dark");
				} else {
					document.documentElement.classList.remove("dark");
				}
			})();
		</script>
	</head>
	<body>
		<a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-text-main focus:text-bg-app focus:font-bold focus:uppercase focus:tracking-widest focus:text-xs">
			Skip to content
		</a>
		<div class="min-h-screen flex flex-col">
			<header class="pointer-events-none fixed top-0 left-0 z-50 flex h-chrome-height w-full items-center gap-1 bg-bg-app px-chrome-inset sm:gap-3">
				<div class="min-w-0 flex-1">
					<RomeAvailability client:only="react" />
				</div>
				<div class="pointer-events-auto flex shrink-0 items-center gap-1 sm:gap-2 md:gap-4">
					<LanguageSwitcher />
					<ThemeToggle />
				</div>
			</header>

			<main class="flex-1 flex justify-center px-6 pb-6 md:px-12 md:pb-12 lg:px-16 lg:pb-16 pt-chrome-height">
				<div class="w-full max-w-4xl flex flex-col relative">
					<slot />
				</div>
			</main>
		</div>

		<NetlifyFormStub />
	</body>
</html>
