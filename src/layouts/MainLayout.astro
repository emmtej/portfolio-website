---
import "@fontsource-variable/inter";
import '../index.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { RomeAvailability } from '../components/ui/RomeAvailability';
import NetlifyFormStub from '../components/contact/NetlifyFormStub.astro';

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
	includeCanonical?: boolean;
	includeAlternates?: boolean;
	languageSwitcherTarget?: string;
}

const { 
	title = "Emmanuel T. | Software Developer",
	description = "Full-stack web developer specializing in building modern, responsive websites using the React ecosystem, TypeScript, and Tailwind CSS.",
	noindex = false,
	includeCanonical = !noindex,
	includeAlternates = !noindex,
	languageSwitcherTarget,
} = Astro.props;

const locale = Astro.currentLocale || "en";
const site = Astro.site;

if (!site) {
	throw new Error("Astro site configuration is required for absolute metadata URLs.");
}

function normalizePagePath(pathname: string): string {
	if (pathname === "/") return pathname;
	return `${pathname.replace(/\/+$/, "")}/`;
}

const pagePath = normalizePagePath(Astro.url.pathname);
const canonical = new URL(pagePath, site).href;
const ogImage = new URL("/og-image.png", site).href;
const defaultLocalePath = pagePath.replace(/^\/it(?=\/)/, "") || "/";
const italianPath = defaultLocalePath === "/" ? "/it/" : `/it${defaultLocalePath}`;
const englishUrl = new URL(defaultLocalePath, site).href;
const italianUrl = new URL(italianPath, site).href;
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="UTF-8" />
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="ET|DEV" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />

		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta name="author" content="Emmanuel T." />
		{noindex && <meta name="robots" content="noindex,follow" />}
		{includeCanonical && <link rel="canonical" href={canonical} />}

		{!noindex && <meta property="og:type" content="website" />}
		{!noindex && <meta property="og:url" content={canonical} />}
		{!noindex && <meta property="og:title" content={title} />}
		{!noindex && <meta property="og:description" content={description} />}
		{!noindex && <meta property="og:image" content={ogImage} />}

		{!noindex && <meta property="twitter:card" content="summary_large_image" />}
		{!noindex && <meta property="twitter:url" content={canonical} />}
		{!noindex && <meta property="twitter:title" content={title} />}
		{!noindex && <meta property="twitter:description" content={description} />}
		{!noindex && <meta property="twitter:image" content={ogImage} />}

		{includeAlternates && <link rel="alternate" hreflang="en" href={englishUrl} />}
		{includeAlternates && <link rel="alternate" hreflang="it" href={italianUrl} />}
		{includeAlternates && <link rel="alternate" hreflang="x-default" href={englishUrl} />}

		<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />

		<script is:inline>
			(function () {
				const saved = localStorage.getItem("theme");
				if (
					saved === "dark" ||
					(!saved && window.matchMedia("(prefers-color-scheme: dark)").matches)
				) {
					document.documentElement.classList.add("dark");
				} else {
					document.documentElement.classList.remove("dark");
				}
			})();
		</script>
	</head>
	<body>
		<a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-text-main focus:text-bg-app focus:font-bold focus:uppercase focus:tracking-widest focus:text-xs">
			Skip to content
		</a>
		<div class="min-h-screen flex flex-col">
			<header class="pointer-events-none fixed top-0 left-0 z-50 flex h-chrome-height w-full items-center gap-1 bg-bg-app px-chrome-inset sm:gap-3">
				<div class="min-w-0 flex-1">
					<RomeAvailability client:only="react" />
				</div>
				<div class="pointer-events-auto flex shrink-0 items-center gap-1 sm:gap-2 md:gap-4">
					<LanguageSwitcher targetUrl={languageSwitcherTarget} />
					<ThemeToggle />
				</div>
			</header>

			<main class="flex-1 flex justify-center px-6 pb-6 md:px-12 md:pb-12 lg:px-16 lg:pb-16 pt-chrome-height">
				<div class="w-full max-w-4xl flex flex-col relative">
					<slot />
				</div>
			</main>
		</div>

		<NetlifyFormStub />
	</body>
</html>
